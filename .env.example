# ==============================================================================
# JAPANESE LEARNING TELEGRAM BOT - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ==============================================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================================
# Get your bot token from @BotFather on Telegram
# Format: 123456789:ABCdefGHIjklMNOpqrSTUvwxyz-1234567890
BOT_TOKEN=your_bot_token_here

# Bot username (without @)
BOT_USERNAME=your_bot_username

# Webhook URL for production (leave empty for polling in development)
WEBHOOK_URL=

# Port for webhook server (only needed if using webhooks)
WEBHOOK_PORT=8443

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Database URL - SQLite for development, PostgreSQL for production
# SQLite: sqlite:///japanese_bot.db
# PostgreSQL: postgresql://user:password@localhost:5432/japanese_bot_db
DATABASE_URL=sqlite:///japanese_bot.db

# Database connection pool settings (for PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==============================================================================
# LEARNING SYSTEM CONFIGURATION
# ==============================================================================
# Default lesson settings
DEFAULT_LESSON_SIZE=5
DEFAULT_QUIZ_SIZE=10
SPACED_REPETITION_INTERVALS=1,3,7,14,30

# Streak and progress settings
STREAK_RESET_HOURS=48
DAILY_GOAL_DEFAULT=20
WEEKLY_GOAL_DEFAULT=100

# Difficulty adjustment thresholds (percentage)
EASY_THRESHOLD=90
HARD_THRESHOLD=60

# ==============================================================================
# REMINDER SYSTEM
# ==============================================================================
# Default reminder times (24-hour format, comma-separated)
DEFAULT_REMINDER_TIMES=09:00,18:00

# Timezone for reminders (e.g., UTC, Europe/London, America/New_York)
DEFAULT_TIMEZONE=UTC

# Maximum reminders per user
MAX_REMINDERS_PER_USER=5

# ==============================================================================
# CONTENT MANAGEMENT
# ==============================================================================
# Paths to content files (relative to project root)
HIRAGANA_DATA_PATH=data/hiragana.json
KATAKANA_DATA_PATH=data/katakana.json
KANJI_DATA_PATH=data/kanji.json
VOCABULARY_DATA_PATH=data/vocabulary.json

# Maximum content items to load in memory
MAX_CONTENT_CACHE_SIZE=1000

# ==============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# ==============================================================================
# Google Translate API (for additional translations)
GOOGLE_TRANSLATE_API_KEY=

# Japanese pronunciation API (if using external service)
PRONUNCIATION_API_KEY=
PRONUNCIATION_API_URL=

# Analytics service (optional)
ANALYTICS_API_KEY=

# ==============================================================================
# LOGGING AND MONITORING
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty to log to console only)
LOG_FILE=logs/japanese_bot.log

# Maximum log file size in MB
MAX_LOG_SIZE=10

# Number of log files to keep
LOG_BACKUP_COUNT=5

# ==============================================================================
# SECURITY AND RATE LIMITING
# ==============================================================================
# Rate limiting settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_COMMANDS_PER_MINUTE=10

# Admin user IDs (comma-separated Telegram user IDs)
ADMIN_USER_IDS=

# Enable/disable new user registration
ALLOW_NEW_USERS=true

# Maximum users (0 for unlimited)
MAX_USERS=0

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (more verbose logging and error messages)
DEBUG=true

# Enable development features (test commands, etc.)
DEV_MODE=true

# Use polling instead of webhooks in development
USE_POLLING=true

# ==============================================================================
# BACKUP AND MAINTENANCE
# ==============================================================================
# Automatic backup settings
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=backups/

# Maintenance mode message
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Bot is temporarily under maintenance. Please try again later.

# ==============================================================================
# PERFORMANCE SETTINGS
# ==============================================================================
# Connection timeouts (seconds)
HTTP_TIMEOUT=30
DATABASE_TIMEOUT=10

# Memory usage limits
MAX_MEMORY_USAGE_MB=512

# Cache settings
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
# Enable/disable specific features
FEATURE_VOICE_MESSAGES=true
FEATURE_IMAGE_RECOGNITION=false
FEATURE_ADVANCED_STATS=true
FEATURE_LEADERBOARD=true
FEATURE_CULTURAL_NOTES=true
FEATURE_PRONUNCIATION_CHECK=false

# ==============================================================================
# LOCALIZATION
# ==============================================================================
# Default language for the bot interface
DEFAULT_LANGUAGE=en

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,ja,es,fr,de

# ==============================================================================
# EXAMPLE VALUES (REMOVE IN PRODUCTION)
# ==============================================================================
# Example bot token format: 123456789:ABCdefGHIjklMNOpqrSTUvwxyz-1234567890
# Example admin user ID: 123456789
# Example webhook URL: https://yourdomain.com/webhook
# Example PostgreSQL URL: postgresql://username:password@localhost:5432/database_name
